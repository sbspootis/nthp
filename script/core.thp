
PRIVATE stage
PRIVATE player

PRIVATE sc_fps
SET &sc_fps 60

@sf_createStage ( &stage )

@sf_addObject ( 100 180 200 15 0 )
@sf_addObject ( 250 0 15 200 0 )
@sf_addObject ( 25 100 100 15 0 )

@sf_initStage


@pf_setPlayerTarget ( &player )
@pf_init

CONST l_resetPlayer 10
LABEL #l_resetPlayer

SET $player.ground_acceleration 0.004
SET $player.jump_height         0.6
SET $player.MAX_playerSpeed     0.3
SET $player.MAX_fallSpeed       0.5
SET $player.onSolidGround       #TRUE
SET $player.vel_x               0
SET $player.vel_y               0
SET $player.friction            0.003
SET $player.gravity             0.002


ENT_SETPOS #e_player 0 0

LABEL 1

        IF $returnKeyPress
                SET &returnKeyPress #FALSE
                GOTO #l_resetPlayer
        END

        IF $upKeyPress
                ADD $sc_fps 15 &sc_fps
                CORE_SETMAXFPS $sc_fps
                SET &upKeyPress #FALSE
                PRINT $sc_fps
        END

        IF $downKeyPress
                SUB $sc_fps 15 &sc_fps
                CORE_SETMAXFPS $sc_fps
                SET &downKeyPress #FALSE
                PRINT $sc_fps
        END


        @pf_checkPlayerInput
        @sf_checkStageCollision ( $player )



        SET &mathReg0 0
        ADD #requiredPlayerObjects *stage &mathReg2


        CORE_CLEAR
        
        LABEL 2
                
                CORE_QRENDER $mathReg0
                

                INC &mathReg0
                IF $mathReg0 LST $mathReg2
                        GOTO 2
                END

        CORE_DISPLAY

SUSPEND
GOTO 1


EXIT