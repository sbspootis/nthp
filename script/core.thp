
PRIVATE stage

@sf_createStage ( &stage )

@sf_addObject ( 0 180 200 15 0 )
@sf_addObject ( 180 0 15 200 0 )

@sf_initStage


STRING testString "this is a test. Copy to block!"
PRIVATE bString
ALLOC 20 &bString       / Input string test. /

PRIVATE trackingInput
SET &trackingInput 1
IB_SET_TARGET $bString  / Input keyboard presses into bString block. /

LABEL 1

        IF $trackingInput
                IF $returnKeyPress
                        IB_STOP
                        SET &trackingInput 0
                        SKIP
                END

                IB_WRITE_STRING
        END

        SKIP_END


        SET &mathReg0 0
        ADD 2 *stage &mathReg2
        CORE_CLEAR
        
        LABEL 2
                
                CORE_QRENDER $mathReg0

                INC &mathReg0
                IF $mathReg0 LST $mathReg2
                        GOTO 2
                END

        CORE_DISPLAY

SUSPEND
GOTO 1


EXIT