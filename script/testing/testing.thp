STRING title "testing"
CORE_INIT 150 150 150 150 0 0 0 0 ~title

STRING paletteFile "resource/genericPalette.pal"
SET_ACTIVE_PALETTE ~paletteFile

STRING testTexture "resource/hudSheet.st"

VAR texture
TEXTURE_ALLOC 1 &texture

TEXTURE_LOAD $texture ~testTexture

VAR frame
FRAME_ALLOC 1 &frame
FRAME_SET $frame 0 0 2245 172 $texture


VAR ent
ENT_ALLOC 1 &ent

ENT_SETRENDERSIZE $ent 50 50
ENT_SETFRAMERANGE $ent $frame 1


EXIT