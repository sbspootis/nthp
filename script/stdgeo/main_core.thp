
@f_newStage

SET $stageObjects.type #CIRCLE
SET $stageObjects.bounds_x 100
SET $stageObjects.bounds_y 150
SET $stageObjects.flags 22

@f_addObject ( #RECT 100 200 10 10 0 0 15 )

@f_addObject ( #RECT 110 200 20 10 0 0 15 )

@f_addObject ( #RECT 120 200 10 10 0 0 15 )

@f_addObject ( #RECT 130 200 10 10 0 0 15 )

LABEL 1

        CORE_CLEAR
        

        CORE_DISPLAY

        SUSPEND
        GOTO 1


EXIT