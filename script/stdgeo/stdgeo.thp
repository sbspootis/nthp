	
VAR argReg0
VAR argReg1
VAR argReg2
VAR argReg3
VAR argReg4
VAR stdgeoReturn

PRIVATE a_xw
PRIVATE a_yh
PRIVATE b_xw
PRIVATE b_yh




STRUCT Rect { x y w h }
STRUCT Circle { x y r }
STRUCT Ray


MACRO f_stdgeo_setRect {
	ASSIGN Rect &argReg0
	
	SET &argReg0 #ar0
	SET $argReg0.x #ar1
	SET $argReg0.y #ar2
	SET $argReg0.w #ar3
	SET $argReg0.h #ar4
	
	UNASSIGN &argReg0
}





MACRO f_stdgeo_checkCollision {
	SET &argReg0 #ar0
	SET &argReg1 #ar1
	SET &stdgeoReturn #ar2
	FUNC_CALL func_stdgeo_checkCollision
}

FUNC func_stdgeo_checkCollision {
	ASSIGN Rect &argReg0 
	ASSIGN Rect &argReg1
	
	ADD *argReg0.x *argReg0.w &a_xw
	ADD *argReg0.y *argReg0.h &a_yh
	
	ADD *argReg1.x *argReg1.w &b_xw
	ADD *argReg1.y *argReg1.h &b_yh
	
	IF $a_xw GRTE *argReg1.x
		IF *argReg0.x LSTE $b_xw
			IF $a_yh GRTE *argReg1.y
				IF *argReg0.y LSTE $b_yh
					SET $stdgeoReturn 1
					RETURN
				END
			
			END
		
		END
	
	END
	
	SET $stdgeoReturn 0
	
	UNASSIGN &argReg0
	UNASSIGN &argReg1
}

EXIT