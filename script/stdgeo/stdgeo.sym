VAR argReg0
VAR argReg1
VAR argReg2
VAR argReg3
VAR argReg4
VAR stdgeoReturn
PRIVATE a_xw
PRIVATE a_yh
PRIVATE b_xw
PRIVATE b_yh
STRUCT Rect { x y w h }
STRUCT Circle { x y r }
MACRO f_stdgeo_setRect { ASSIGN Rect &argReg0 SET &argReg0 #ar0 SET $argReg0.x #ar1 SET $argReg0.y #ar2 SET $argReg0.w #ar3 SET $argReg0.h #ar4 UNASSIGN &argReg0 }
MACRO f_stdgeo_checkCollision { SET &argReg0 #ar0 SET &argReg1 #ar1 SET &stdgeoReturn #ar2 FUNC_CALL func_stdgeo_checkCollision }
FUNC func_stdgeo_checkCollision
ASSIGN Rect &argReg0
ASSIGN Rect &argReg1
UNASSIGN &argReg0
UNASSIGN &argReg1
EXIT
