IMPORT script/stdgeo/globals.b


/ STDGEO geometry maker program ; THP 2.03 /
STRUCT programConfig {
        x_res
        y_res

        last_camera_x
        last_camera_y

        last_camera_res_x
        last_camera_res_y
}
VAR config
ASSIGN programConfig &config

STRING configSaveFile "defaults.config"
DFILE_READ &config ~configSaveFile

IF $null NOT 0
        STRING fail_openConfig "ERROR: Failed to open default config file; creating with defaults..."
        PRINT ~fail_openConfig

        NEW programConfig 1 &config
        SET $config.x_res 960
        SET $config.y_res 540

        SET $config.last_camera_x 0
        SET $config.last_camera_y 0

        SET $config.last_camera_res_x 960
        SET $config.last_camera_res_y 540


        DFILE_WRITE $config ~configSaveFile

        STRING success_createConfig "Created and populated config 'defaults.config' in home directory."
        PRINT ~success_createConfig
END

STRING title "STDGEO - v0.1"
CORE_INIT *config.x_res *config.y_res *config.last_camera_res_x *config.last_camera_res_y 0 0 0 0 ~title


STRING ui_menuBarFile "resource/menuBar.cst"

/ Texture indecies /
ENUM {
        ti_uiMenuBar


        tc_size
}


VAR p_uiTextures
TEXTURE_ALLOC #tc_size &p_uiTextures

TEXTURE_LOAD $p_uiTextures.#ti_uiMenuBar ~ui_menuBarFile



VAR p_uiFrames
FRAME_ALLOC #tc_size &p_uiFrames






EXIT