
VAR stageObjectEntities
PRIVATE p_temp
ASSIGN stdgeoObject &p_temp

MACRO f_resizeStage {
	SET &arg0 #ar0
	FUNC_CALL func_resizeStage
}
FUNC func_resizeStage {
	NEW stdgeoObject $arg0 &p_temp
        INDEX &stageObjects 0

        IF $arg0 LST $stageSize
                SET &stageSize $arg0
        END

	MUL $stageSize >stdgeoObject &mathReg0   / Calculate widths to copy. /
        COPY $stageObjects $mathReg0 $p_temp
        
        FREE $stageObjects

        SET &stageObjects $p_temp
        SET &stageSize $arg0
}


/ Type, bounds_x, bounds_y, bounds_w, bounds_h, origin_x, origin_y, flags /
MACRO f_addObject {
        SET &workingObject.type #ar0
        SET &workingObject.bounds_x #ar1
        SET &workingObject.bounds_y #ar2
        SET &workingObject.bounds_w #ar3
        SET &workingObject.bounds_h #ar4
        SET &workingObject.origin_x #ar5
        SET &workingObject.origin_y #ar6
        SET &workingObject.flags #ar7

        FUNC_CALL func_addObject
}

FUNC func_addObject {
        ADD 1 $stageSize &mathReg0
        @f_resizeStage ( $mathReg0 )

        LAST &stageObjects

        COPY &workingObject >stdgeoObject $stageObjects
}





MACRO f_newStage {
	FUNC_CALL func_newStage
}

FUNC func_newStage {
	IF $stageSize GRT 0
		FREE $stageObjects
		ENT_FREE $stageObjectEntities
	END
	
	
	SET &stageSize 1
	NEW stdgeoObject 1 &stageObjects 
}





EXIT