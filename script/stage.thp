
/ ============================== =================================== ============================ ===== /
/ ============================== =================================== ============================ ===== /
/ ============================== =================================== ============================ ===== /
/                               STAGE BINARY STRUCTURE SECTION                                          /

STRUCT stageObj {
        col_x
        col_y
        col_w
        col_h

        isHazard
}

PRIVATE p_stagePtr
PRIVATE p_tempAlloc
PRIVATE ps_currentStageSize

PRIVATE p_extern

CONST requiredPlayerObjects 3

/ Populates an address (and the active stage) with a new stage structure of size 1 /
FUNC s_createStage {
        ALLOC 1 &p_stagePtr                     / Init a new block with 1 entry. /
        SET &ps_currentStageSize $p_stagePtr
        SET $ps_currentStageSize 0

        SET &p_extern $argReg0                  / Copy the new block ptr_descriptor to the external address /
        SET $argReg0 $p_stagePtr

}


/ Reallocates using a second block with 'p_tempAlloc' and adds a new object, freeing the old one. /
FUNC s_addobj {
        CONST new_x $argReg0
        CONST new_y $argReg1
        CONST new_w $argReg2
        CONST new_h $argReg3
        CONST new_haz $argReg4


        CONST old_size $mathReg0

        SET &mathReg0 *ps_currentStageSize              / mathReg0 is now the old size. /
        INC $ps_currentStageSize

        MUL *ps_currentStageSize >stageObj &mathReg1    / MathReg1 is now the new size. /
        INC &mathReg1

        ALLOC $mathReg1 &p_tempAlloc
        MUL $mathReg0 >stageObj &mathReg0
        INC &mathReg0                                   / mathReg0 is also the origin of the new object. /

        COPY $p_stagePtr $mathReg0 $p_tempAlloc
        
        INDEX &p_tempAlloc $mathReg0

        ASSIGN stageObj &p_tempAlloc                     / Copy all the data into the block. /
                SET $p_tempAlloc.col_x #new_x
                SET $p_tempAlloc.col_y #new_y
                SET $p_tempAlloc.col_w #new_w
                SET $p_tempAlloc.col_h #new_h
                SET $p_tempAlloc.isHazard #new_haz
        UNASSIGN &p_tempAlloc

        FREE $p_stagePtr
        INDEX &p_tempAlloc 0

        SET &p_stagePtr $p_tempAlloc
        SET &ps_currentStageSize $p_tempAlloc           / ps_currentStageSize is the new size; set above. /
        SET $p_extern $p_stagePtr                       / Update external interface to the new block. /


}

FUNC s_setActiveStage {
        SET &p_stagePtr *argReg0
        SET &ps_currentStageSize *argReg0
        SET &p_extern $argReg0
}


MACRO sf_addObject {
        SET &argReg0 #ar0
        SET &argReg1 #ar1
        SET &argReg2 #ar2
        SET &argReg3 #ar3
        SET &argReg4 #ar4
        %s_addobj
}


MACRO sf_createStage {
        SET &argReg0 #ar0
        %s_createStage
}

MACRO sf_setActiveStage {
        SET &argReg0 #ar0
        %s_setActiveStage
}


/ ============================== =================================== ============================ ===== /
/ ============================== =================================== ============================ ===== /
/ ============================== =================================== ============================ ===== /
/                               STAGE GENERATION AND ENTITY CONFIG SECTION                              /


CONST e_player  0
CONST e_pan     1

FUNC s_initStage {
        IF *ps_currentStageSize LSTE 0                  / Make sure stage actually fucking exists. /

                STRING stage_error_noSize "Error: Stage size 0; no init."
                PRINT ~stage_error_noSize
                RETURN
        END

        ADD #requiredPlayerObjects *ps_currentStageSize &mathReg0            / mathReg0 is the number of entities to allocate (with player+pan+collider included) /
        ENT_DEFINE $mathReg0

        ENT_SETFRAMERANGE #e_player #f0_player 1
        ENT_SETRENDERSIZE #e_player 10 10
        ENT_SETHITBOXSIZE #e_player 10 10
        ENT_SETCURRENTFRAME #e_player 0 

        ENT_SETHITBOXSIZE #e_playerProjectedHitbox 10 10
        ENT_SETFRAMERANGE #e_playerProjectedHitbox #f0_player 1
        ENT_SETRENDERSIZE #e_playerProjectedHitbox 10 10
        ENT_SETHITBOXSIZE #e_playerProjectedHitbox 10 10
        ENT_SETCURRENTFRAME #e_playerProjectedHitbox 0 

        ENT_SETFRAMERANGE #e_pan #f0_pan 1
        ENT_SETRENDERSIZE #e_pan 4 4
        ENT_SETHITBOXSIZE #e_pan 4 4
        ENT_SETCURRENTFRAME #e_pan 0

        SET &mathReg1 0                                 / mathReg1 is a counter to loop through generated stage data. /
        SET &mathReg2 0                                 / mathReg2 is the calculated origin of each object. /
        SET &mathReg3 #requiredPlayerObjects            / mathReg3 is the absolute entity position counter. /
        ASSIGN stageObj &p_stagePtr

        INDEX &p_stagePtr 1

        LABEL 1

                        
                ENT_SETHITBOXSIZE $mathReg3 *p_stagePtr.col_w *p_stagePtr.col_h         / Copy data and configure entity. /
                ENT_SETPOS $mathReg3 *p_stagePtr.col_x *p_stagePtr.col_y

                / TODO: Different texture when hazardous. /

                ENT_SETFRAMERANGE $mathReg3 #f0_wall 1
                ENT_SETCURRENTFRAME $mathReg3 0
                ENT_SETRENDERSIZE $mathReg3 *p_stagePtr.col_w *p_stagePtr.col_h

                INC &mathReg3
                INC &mathReg1
                IF $mathReg3 LST $mathReg0
                        NEXT &p_stagePtr
                        GOTO 1
                END

        UNASSIGN &p_stagePtr

}

MACRO sf_initStage {
        %s_initStage
}


PRIVATE pl_x
PRIVATE pl_y
PRIVATE pl_w
PRIVATE pl_h

PRIVATE ent_x
PRIVATE ent_y
PRIVATE ent_w
PRIVATE ent_h

PRIVATE ent_counter
PRIVATE vx_vy

PRIVATE prt_stageSize

PRIVATE pl_target ASSIGN playerData &pl_target

MACRO p_placeOnTop {
        SET $pl_target.vel_y 0
        SET $pl_target.onSolidGround 1
        SET $pl_target.currentSolidGround $ent_counter

        SUB $ent_y $pl_h &mathReg4
        PREV &mathReg4
        ENT_SETPOS #e_player $pl_x $mathReg4
        SKIP
}

MACRO p_stopLeft {
        SUB $ent_x $pl_w &mathReg4
        PREV &mathReg4
        SET $pl_target.vel_x 0
        ENT_SETPOS #e_player $mathReg4 $pl_y
        SKIP
}

MACRO p_stopRight {
        SET $pl_target.vel_x 0
        SET &mathReg4 #ent_xw
        NEXT &mathReg4
        ENT_SETPOS #e_player $mathReg4 $pl_y

        SKIP
}

MACRO p_stopBottom {
        SET $pl_target.vel_y 0
        ENT_SETPOS #e_player $pl_x #ent_yh
        SKIP
}




FUNC s_checkStageCollision {

        SET &pl_target $argReg0

        SET &ent_counter #requiredPlayerObjects
        ADD #requiredPlayerObjects *ps_currentStageSize &prt_stageSize

        IF *pl_target.vel_y
                DIV *pl_target.vel_x *pl_target.vel_y &vx_vy
        ELSE
                SET &vx_vy *pl_target.vel_x
        END

        ABS $vx_vy &vx_vy

        LABEL 200

                IF $ent_counter NOT *pl_target.currentSolidGround

                        ENT_CHECKCOLLISION #e_playerProjectedHitbox $ent_counter &mathReg1
                        IF $mathReg1
                                / Check bounds of player relative to object; NOT THE PROJECTED. /
                                POLL #e_player HITBOX
                                COPY &r_poll1 4 &pl_x

                                ADD $pl_x $pl_w &mathReg0 CONST pl_xw $mathReg0
                                ADD $pl_y $pl_h &mathReg1 CONST pl_yh $mathReg1

                                POLL $ent_counter HITBOX
                                COPY &r_poll1 4 &ent_x

                                ADD $ent_x $ent_w &mathReg2 CONST ent_xw $mathReg2 / Assign hitbox bounds to math registers. /
                                ADD $ent_y $ent_h &mathReg3 CONST ent_yh $mathReg3 / Assign hitbox bounds to math registers. /

                                / FREE MATH REGISTERS:
                                        - mathReg4
                                        - mathReg5
                                /

                                IF $pl_x LST $ent_x
                                        IF $pl_y LST $ent_y
                                                / TOP-CORNER-LEFT Collision /
                                                IF *pl_target.onSolidGround EQU 0
                                                        RSHIFT &pl_h 1
                                                        ADD $pl_h $pl_y &mathReg4
                                                        IF $mathReg4 GRT $ent_y
                                                                @p_placeOnTop
                                                                SKIP
                                                        ELSE
                                                                @p_stopLeft
                                                                SKIP
                                                        END
                                                END
                                        ELSE

                                                IF #pl_yh GRT #ent_yh
                                                        / BOTTON-CORNER-LEFT Collision /

                                                ELSE
                                                        / LEFT-MIDDLE Collision /
                                                        @p_stopLeft
                                                        SKIP
                                                END
                                        END
                                ELSE
                                        IF #pl_xw GRT #ent_xw

                                                IF $pl_y LST $ent_y
                                                        / TOP-CORNER-RIGHT Collision /
                                                        IF *pl_target.onSolidGround EQU 0
                                                                SET &mathReg4 $pl_h RSHIFT &mathReg4 1
                                                                ADD $mathReg4 $pl_y &mathReg5
                                                                IF $mathReg5 GRT $ent_y
                                                                        @p_placeOnTop
                                                                ELSE
                                                                        @p_stopRight
                                                                END
                                                                SKIP
                                                        END
                                                ELSE

                                                        IF #pl_yh GRT #ent_yh
                                                                / BOTTOM-CORNER-RIGHT Collision /
                                                                
                                                        ELSE
                                                                / RIGHT-MIDDLE Collision /
                                                                @p_stopRight
                                                                SKIP
                                                        END
                                                END

                                        ELSE
                                        
                                                IF $pl_y LST $ent_y
                                                        / TOP-MIDDLE Collision /
                                                        @p_placeOnTop
                                                        SKIP
                                                ELSE

                                                        IF #pl_yh GRT #ent_yh
                                                                / BOTTOM-MIDDLE Collision /
                                                                @p_stopBottom
                                                                SKIP
                                                        ELSE
                                                                / CENTER Collision (should be impossible.) /
                                                        END
                                                END
                                        END
                                END
                        END     
                        / DETECTION BLOCK /
                END

        SKIP_END

        IF *pl_target.onSolidGround
                POLL *pl_target.currentSolidGround HITBOX
                ADD $r_poll1 $r_poll3 &mathReg2         
                SET &ent_x $r_poll1

                POLL #e_player HITBOX
                COPY &r_poll1 4 &pl_x
                ADD $pl_x $pl_w &mathReg0

                IF $pl_x GRT #ent_xw
                        SET $pl_target.onSolidGround 0
                        SET $pl_target.currentSolidGround -1

                        SKIP
                END

                IF #pl_xw LST $ent_x
                        SET $pl_target.onSolidGround 0
                        SET $pl_target.currentSolidGround -1

                        SKIP
                END
        END


        SKIP_END


        INC &ent_counter
        IF $ent_counter LST $prt_stageSize
                GOTO 200
        END

}


MACRO sf_checkStageCollision {
        SET &argReg0 #ar0
        %s_checkStageCollision
}













EXIT