/ STDGAME standard toolset. /

/ TEXTURES AND ANIMATIONS /

/ Builds a frameset for any given texture and frame dimensions. Generates along X. /
/ TEXTURE | FRAME_DIMENSIONS (ywh) | NUMBER OF FRAMES | OUTPUT /
MACRO gamef_createAnimationX {
        SET &argReg0 #ar0
        SET &argReg1 #ar1
        SET &argReg2 #ar2
        SET &argReg3 #ar3
        SET &argReg4 #ar4
        SET &argReg5 #ar5

        FUNC_CALL stdgame_createAnimationX
}
FUNC stdgame_createAnimationX {

        CONSTEVAL texture       &argReg0
        CONSTEVAL y             &argReg1
        CONSTEVAL w             &argReg2
        CONSTEVAL h             &argReg3
        CONSTEVAL frameCount    &argReg4
        CONSTEVAL output        &argReg5

        CONSTEVAL counter       &mathReg0
        CONSTEVAL newAlignment  &mathReg1

        FRAME_ALLOC ^$frameCount ^$output

        SET ^&counter 0

        LABEL 0

                MUL ^$counter ^$w ^&newAlignment

                FRAME_SET ^$output.^$counter ^$newAlignment ^y ^$w ^$h ^$texture

                INC ^&counter
                IF ^$counter LST ^$frameCount
                        GOTO 0
                END

}






/ ALLOCATION FUNCTIONS /

/ TARGET BLOCK | NEW SIZE | OUTPUT /
MACRO gamef_reallocBlock {
        SET &argReg0 #ar0
        SET &argReg1 #ar1
        SET &argReg2 #ar2
        FUNC_CALL stdgame_reallocBlock
}

FUNC stdgame_reallocBlock {

        CONSTEVAL targetBlock   &argReg0
        CONSTEVAL size          &argReg1
        CONSTEVAL output        &argReg2

        CONSTEVAL p_temp        &gpReg0
        CONSTEVAL oldSize       &gpReg1

        ALLOC ^$size ^&p_temp
        
        GET_BLOCKSIZE ^$targetBlock ^&oldSize

        IF ^$oldSize GRTE ^$size
                COPY ^$targetBlock ^$size ^$p_temp
        ELSE
                COPY ^$targetBlock ^$oldSize ^$p_temp
        END

        SET ^$output ^$p_temp 

        FREE ^$targetBlock
}

/       MAGNITUDE     |       DIRECTION       |         OUTPUT  /
MACRO gamef_getNormalVector {
        SET &argReg0 #ar0
        SET &argReg1 #ar1
        SET &argReg2 #ar2
        FUNC_CALL stdgame_getNormalVector
}


FUNC stdgame_getNormalVector {
        CONSTEVAL magnitude     &argReg0
        CONSTEVAL angle         &argReg1
        CONSTEVAL output        &argReg2

        CONSTEVAL y_angle       &gpReg0
        CONSTEVAL x_angle       &gpReg1

        ASSIGN vector &argReg2

        MUL ^pi ^$angle &mathReg0
        DIV $mathReg0 180 &mathReg0


        SIN $mathReg0 ^&y_angle
        MUL ^$y_angle ^-$magnitude $argReg2.y      / Negate the magnitude because up is actually down /
        
        COS $mathReg0 ^&x_angle
        MUL ^$x_angle ^$magnitude $argReg2.x

        UNASSIGN &argReg2
}


/       VECTOR OBJECT   |       OUTPUT          /
MACRO gamef_getVectorAngle {
        SET &argReg0 #ar0
        SET &argReg1 #ar1

        FUNC_CALL stdgame_getVectorAngle
}


FUNC stdgame_getVectorAngle {
        CONSTEVAL vectorObject  &argReg0
        CONSTEVAL output        &argReg1
        
        CONSTEVAL initital_angle &mathReg0
        CONSTEVAL calculatedAngle &mathReg1

        CONSTEVAL offsetModifier &mathReg2

        ASSIGN vector &argReg0
		IF ^*argReg0.x EQU 0
			IF ^*argReg0.y EQU 0
				SET $argReg1 0
				RETURN
			END
		END
		
		
        IF ^*argReg0.x GRT 0
                IF ^*argReg0.y GRT 0
                        SET ^&offsetModifier 360
                ELSE
                        SET ^&offsetModifier 0
                END
        ELSE
                IF ^*argReg0.x LST 0
                        SET ^&offsetModifier 180
                ELSE
                        IF ^*argReg0.y GRT 0
                                SET $argReg1 270
                                RETURN
                        END
                        IF ^*argReg0.y LST 0
                                SET $argReg1 90
                                RETURN
                        END
                END
        END



        IF ^*argReg0.x EQU 0
                IF ^*argReg0.y GRT 0
                        SET $argReg1 270
                        RETURN
                END
                IF ^*argReg0.y LST 0
                        SET $argReg1 90
                        RETURN
                END
        END


        DIV ^-*argReg0.y ^*argReg0.x ^&initital_angle
        ATAN ^$initital_angle ^&calculatedAngle

        MUL ^$calculatedAngle 180 ^&calculatedAngle
        DIV ^$calculatedAngle ^pi ^&calculatedAngle
        ADD ^$calculatedAngle ^$offsetModifier ^&calculatedAngle

        SET $argReg1 ^$calculatedAngle
        UNASSIGN &argReg0
}



/       VALUE   |       OUTPUT  /
MACRO gamef_factorDeltatime {
        MUL #ar0 $deltaTime #ar1
}





EXIT