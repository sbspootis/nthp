
STRING windowTitle "ViewTexture Test"
CORE_INIT @init_flags ~windowTitle

STRING paletteFile "resource/genericPalette.pal"
SET_ACTIVE_PALETTE ~paletteFile


MUSIC_DEFINE 1
STRING track "am.wav"
MUSIC_LOAD 0 ~track
MUSIC_START 0

MUSIC_SETVOLUME 60

SOUND_DEFINE 1
STRING footstep "footsteps2.ogg"
SOUND_LOAD 0 ~footstep
SOUND_SETCHANNEL 0 0

CORE_SETMAXFPS 60
SET_BLOCKLISTSIZE 10

/ ================================================================ /
/                     TEXTURES                                     /



VAR tp_textures

ENUM {
        texture_0
        texture_1
        texture_2
        texture_3
        texture_4
        texture_5

        textureSize
}


TEXTURE_ALLOC #textureSize &tp_textures

STRING texture_A "resource/outputTexture.cst"
STRING texture_B "resource/platform.cst"
STRING texture_C "resource/player_sheet.cst"
STRING texture_D "resource/wall.cst"

TEXTURE_LOAD $tp_textures.#texture_0 ~texture_A
TEXTURE_LOAD $tp_textures.#texture_1 ~texture_B
TEXTURE_LOAD $tp_textures.#texture_2 ~texture_C
TEXTURE_LOAD $tp_textures.#texture_3 ~texture_D

/ =============================================================== /
/                       FRAMES                                    /

VAR fp_frames

FRAME_ALLOC #textureSize &fp_frames

FRAME_SET $fp_frames.#texture_0 0 0 300 228 $tp_textures.#texture_0
FRAME_SET $fp_frames.#texture_1 0 0 180 41 $tp_textures.#texture_1
FRAME_SET $fp_frames.#texture_2 0 0 120 174 $tp_textures.#texture_2
FRAME_SET $fp_frames.#texture_3 0 0 100 76 $tp_textures.#texture_3
FRAME_SET $fp_frames.#texture_4 0 0 834 172 $tp_textures.#texture_4

/ =============================================================== /
/                       ENTITIES                                  /

VAR ep_entities

ENT_ALLOC 4 &ep_entities

ENT_SETFRAMERANGE $ep_entities.#texture_0 $fp_frames.#texture_0 1
ENT_SETRENDERSIZE $ep_entities.#texture_0 300 228

ENT_SETFRAMERANGE $ep_entities.#texture_1 $fp_frames.#texture_1 1
ENT_SETRENDERSIZE $ep_entities.#texture_1 180 41

ENT_SETFRAMERANGE $ep_entities.#texture_2 $fp_frames.#texture_2 1
ENT_SETRENDERSIZE $ep_entities.#texture_2 120 174

ENT_SETFRAMERANGE $ep_entities.#texture_3 $fp_frames.#texture_3 1
ENT_SETRENDERSIZE $ep_entities.#texture_3 100 76



/ =============================================================== /
/                       ACTIONS                                   /



ENUM {
        ai_left
        ai_right
        ai_enter
        ai_halt
        ai_panUp
        ai_panDown
        ai_panLeft
        ai_panRight

        ac_size
}

ACTION_DEFINE #ac_size

VAR a_left
VAR a_right
VAR a_enter
VAR a_halt

VAR a_panUp
VAR a_panDown
VAR a_panLeft
VAR a_panRight

ACTION_BIND #ai_left &a_left LEFT
ACTION_BIND #ai_right &a_right RIGHT
ACTION_BIND #ai_enter &a_enter RETURN
ACTION_BIND #ai_halt &a_halt ESCAPE

ACTION_BIND #ai_panUp &a_panUp w
ACTION_BIND #ai_panDown &a_panDown s
ACTION_BIND #ai_panLeft &a_panLeft a
ACTION_BIND #ai_panRight &a_panRight d


PRIVATE coolVector
NEW vector 1 &coolVector
@gamef_getNormalVector ( 6 108 $coolVector )

PRIVATE angle
@gamef_getVectorAngle ( $coolVector &angle )




PRIVATE powerTest
POW 2 8 &powerTest


EXIT
