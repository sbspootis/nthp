
PRIVATE currentIndex
SET &currentIndex 0

FIXED vector mouseVector
FIXED vector mousePosition
FIXED vector normalVector

PRIVATE angle

PRIVATE count
SET &count 0


PRIVATE executionID
SET &executionID 0


FIXED rayCollision output
FIXED ray mouseRay
FIXED ray rayNumber2

SET &rayNumber2.x1 500 
SET &rayNumber2.y1 650 
SET &rayNumber2.x2 800 
SET &rayNumber2.y2 700

SET &mouseRay.x1 400 
SET &mouseRay.y1 400 
SET &mouseRay.x2 0 
SET &mouseRay.y2 0

VAR mouseXString
ALLOC 6 &mouseXString

VAR inputString
ALLOC 10 &inputString

STRING toRender "this is a very neat message hooray"

VAR textObject
RTEXT_ALLOC 3 &textObject

RTEXT_SETFONT $textObject $newFont
RTEXT_SETPOS $textObject 0 400
RTEXT_SETRENDERSIZE $textObject 12 16
RTEXT_SETKERNING $textObject 11.5

RTEXT_SETSTRINGTARGET $textObject ~toRender

RTEXT_SETFONT $textObject.1 $newFont
RTEXT_SETPOS $textObject.1 0 700
RTEXT_SETRENDERSIZE $textObject.1 12 16
RTEXT_SETKERNING $textObject.1 2

RTEXT_SETSTRINGTARGET $textObject.1 ~$mouseXString


RTEXT_SETFONT $textObject.2 $newFont
RTEXT_SETPOS $textObject.2 0 500
RTEXT_SETRENDERSIZE $textObject.2 12 16
RTEXT_SETKERNING $textObject.2 2

RTEXT_SETSTRINGTARGET $textObject.2 ~$inputString

TEXTINPUT_START $inputString

LABEL 1

        CORE_GETMOUSEPOSITION &mousePosition.x &mousePosition.y
        NUM_TO_STRING $mousePosition.x $mouseXString
        

        SUB $mousePosition.x 400 &mouseVector.x
        SUB $mousePosition.y 400 &mouseVector.y

        @gamef_getVectorAngle ( &mouseVector &angle )
        @gamef_getNormalVector ( 5 $angle &normalVector )

        SET &mouseRay.x2 $mousePosition.x
        SET &mouseRay.y2 $mousePosition.y

        RAY_CHECKCOLLISION &mouseRay &rayNumber2 &output

        IF $a_left
                IF $currentIndex NOT 0
                        DEC &currentIndex
                        SET &a_left 0
                ELSE
                        SET &currentIndex 3
                        SET &a_left 0
                END
        END


        IF $a_right
                INC &currentIndex
                SET &a_right 0
        END
        IF $currentIndex GRT 3
                SET &currentIndex 0
        END

        IF $a_panUp
                INC &executionID
                PRINT $executionID
                SET &a_panUp 0
        END
        IF $a_panDown
                DEC &executionID
                PRINT $executionID
                SET &a_panDown 0
        END

        IF $a_enter
                FUNC_CALL testList.$executionID
                SET &a_enter 0
        END
        IF $a_halt
                TEXTINPUT_REMOVELAST
                SET &a_halt 0
        END
        

        INDEX &ep_entities $currentIndex

        
        CORE_CLEAR
                DRAW_LINE 400 400 $mousePosition.x $mousePosition.y
                DRAW_LINE 500 650 800 700
                
                CORE_QRENDER $ep_entities
                RTEXT_RENDER $textObject
                RTEXT_RENDER $textObject.1
                RTEXT_RENDER $textObject.2
        CORE_DISPLAY


        SUSPEND
        GOTO 1

EXIT