
PRIVATE currentIndex
SET &currentIndex 0

PRIVATE randOutput

CONSTEVAL cam_speed 0.3
CONSTEVAL camCalc       &gpReg0
CONSTEVAL fps           &gpReg1

SET ^&camCalc 0

SET ^&fps 60

LABEL 1


        IF $a_left
                IF $currentIndex NOT 0
                        DEC &currentIndex
                        SET &a_left 0
                ELSE
                        SET &currentIndex 3
                        SET &a_left 0
                END
        END
        IF $a_right
                INC &currentIndex
                SET &a_right 0
        END
        IF $currentIndex GRT 3
                SET &currentIndex 0
        END
        
        IF $a_panLeft
                CORE_SETCAMERAPOSITION 0 0
                SET &a_panLeft 0
        END



        IF $a_panUp
                ADD ^$fps 30 ^&fps
                SET &a_panUp 0
        END

        IF $a_panDown
                SUB ^$fps 30 ^&fps
                SET &a_panDown 0
        END

        CORE_SETMAXFPS ^$fps

        MUL $deltaTime ^cam_speed ^&camCalc
        CORE_MOVECAMERA ^-$camCalc 0


        CORE_MOVECAMERA $mathReg0 $mathReg1
        SET &mathReg0 0
        SET &mathReg1 0

        INDEX &ep_entities $currentIndex


        CORE_CLEAR
                CORE_QRENDER $ep_entities
        CORE_DISPLAY


        SUSPEND
        GOTO 1

EXIT