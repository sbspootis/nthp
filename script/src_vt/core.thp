
PRIVATE currentIndex
SET &currentIndex 0

PRIVATE randOutput

LABEL 1

        IF $a_left
                IF $currentIndex NOT 0
                        DEC &currentIndex
                        SET &a_left 0
                ELSE
                        SET &currentIndex 3
                        SET &a_left 0
                END
        END
        IF $a_right
                INC &currentIndex
                SET &a_right 0
        END
        IF $currentIndex GRT 3
                SET &currentIndex 0
        END
        


        IF $a_panUp
                DEC $testBlock.$counter2
        END

        IF $a_panDown 
                INC $testBlock.$counter2
        END

        IF $a_panLeft
                DEC $testBlock.$counter
        END

        IF $a_panRight 
                INC $testBlock.$counter
        END

        IF $a_enter
                SOUND_PLAY 0
                SET &a_enter 0
        END

        IF $a_halt
                SOUND_STOP 0
        END

        IF $mouse1
                RAND 50 100 &randOutput
                PRINT $randOutput
        END

        CORE_SETCAMERAPOSITION *testBlock.$counter *testBlock.$counter2

        INDEX &ep_entities $currentIndex


        CORE_CLEAR
                CORE_QRENDER $ep_entities
                CORE_SP_QRENDER $sp_mainHud
                CORE_ABS_QRENDER $ep_statusBars.#ei_health
                CORE_ABS_QRENDER $ep_statusBars.#ei_stamina
        CORE_DISPLAY


        SUSPEND
        GOTO 1

EXIT