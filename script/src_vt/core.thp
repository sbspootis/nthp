
PRIVATE currentIndex
SET &currentIndex 0

LABEL 1

        IF $a_left
                IF $currentIndex NOT 0
                        DEC &currentIndex
                        SET &a_left 0
                ELSE
                        SET &currentIndex 3
                        SET &a_left 0
                END
        END
        IF $a_right
                INC &currentIndex
                SET &a_right 0
        END
        IF $currentIndex GRT 3
                SET &currentIndex 0
        END


        IF $a_panUp
                CORE_MOVECAMERA 0 1
        END

        IF $a_panDown 
                CORE_MOVECAMERA 0 -1 
        END

        IF $a_panLeft
                CORE_MOVECAMERA 1 0
        END

        IF $a_panRight 
                CORE_MOVECAMERA -1 0
        END


        INDEX &ep_entities $currentIndex


        CORE_CLEAR
                CORE_QRENDER $ep_entities
                CORE_SP_QRENDER $p_setpieceTest.0
        CORE_DISPLAY


        SUSPEND
        GOTO 1

EXIT