
PRIVATE currentIndex
SET &currentIndex 0

FIXED vector mouseVector
FIXED vector mousePosition
FIXED vector normalVector

PRIVATE angle

PRIVATE count
SET &count 0

LABEL 1
        INC &count
        IF $count GRT 4095
                SET &count 0
        END

        


        CORE_GETMOUSEPOSITION &mousePosition.x &mousePosition.y
        SUB $mousePosition.x 400 &mouseVector.x
        SUB $mousePosition.y 400 &mouseVector.y

        @gamef_getVectorAngle ( &mouseVector &angle )
        @gamef_getNormalVector ( 5 $angle &normalVector )

        PRINT $deltaTime


        IF $a_left
                IF $currentIndex NOT 0
                        DEC &currentIndex
                        SET &a_left 0
                ELSE
                        SET &currentIndex 3
                        SET &a_left 0
                END
        END
        IF $a_right
                INC &currentIndex
                SET &a_right 0
        END
        IF $currentIndex GRT 3
                SET &currentIndex 0
        END
        

        INDEX &ep_entities $currentIndex


        CORE_CLEAR
                DRAW_SETCOLOR $count
                DRAW_LINE 400 400 $mousePosition.x $mousePosition.y
                
                CORE_QRENDER $ep_entities
        CORE_DISPLAY


        SUSPEND
        GOTO 1

EXIT