IMPORT script/globals.b
STRING windowTitle "LSBSFA - The Climb Begins"

PRIVATE str_test
ALLOC 15 &str_test

STRING_COPY $str_test ~windowTitle


MACRO initFlags {
/       x       y       tx      ty      cx      cy      fs      sr      title   /
        960     540     500     500     0       0       0       0       ~windowTitle
}
CORE_INIT @initFlags

CORE_SETMAXFPS 60

STRING PaletteFile "resource/genericPalette.pal"
SET_ACTIVE_PALETTE ~PaletteFile

ACTION_DEFINE 7
CONST a_mLeft           0
CONST a_mRight          1
CONST a_mJump           2
CONST a_panThrow        3
CONST a_return          4
CONST a_up              5
CONST a_down            6

VAR leftKeyPress        / Tracks LEFT movement.         /
VAR rightKeyPress       / Tracks RIGHT movement.        /
VAR jumpKeyPress        / Tracks JUMP input.            /
VAR panKeyPress         / Tracks pan throw input.       /
VAR returnKeyPress      / Tracks RETURN key press.      /
VAR upKeyPress
VAR downKeyPress


ACTION_BIND #a_mLeft &leftKeyPress      LEFT
ACTION_BIND #a_mRight &rightKeyPress    RIGHT
ACTION_BIND #a_mJump &jumpKeyPress      SPACE
ACTION_BIND #a_panThrow &panKeyPress    LCTRL
ACTION_BIND #a_return &returnKeyPress   RETURN
ACTION_BIND #a_up &upKeyPress           UP
ACTION_BIND #a_down &downKeyPress       DOWN


TEXTURE_DEFINE 3
CONST t_player  0       STRING playerTextureFile "resource/player.cst"
CONST t_pan     1       STRING panTextureFile "resource/pan.cst"
CONST t_wall    2       STRING wallTextureFile "resource/wall.cst"

TEXTURE_LOAD #t_player ~playerTextureFile
TEXTURE_LOAD #t_pan ~panTextureFile
TEXTURE_LOAD #t_wall ~wallTextureFile

FRAME_DEFINE 3
CONST f0_player 0
CONST f0_pan    1
CONST f0_wall   2

FRAME_SET #f0_player    0 0 20 20       #t_player
FRAME_SET #f0_pan       0 0 63 41       #t_pan
FRAME_SET #f0_wall      0 0 100 76      #t_wall

EXIT